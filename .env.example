# Workspace API token from the otari.ai dashboard (starts with otk_).
# Leave empty to run in clearly labeled MOCK mode. Never commit a real token.
OTARI_API_KEY=

# Optional second workspace key for the per-user budget demo (ap-agent-west).
OTARI_API_KEY_WEST=

# Hosted US endpoint. EU accounts should use https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# auto (default): live when OTARI_API_KEY is set, otherwise mock
# mock: force the labeled mock even if a key is present
# live: require a key and call hosted Otari
OTARI_MODE=auto

# Confirm exact selectors on the Otari Models page ("Use this model").
# Defaults are documented open-weight examples from Otari's own quickstart/blog.
OTARI_MODEL_ANALYST=deepseek/deepseek-v4-pro-0813
OTARI_MODEL_VERIFIER=mistral/mistral-large-4

# Name of a Fallback routing policy created in the Otari dashboard.
OTARI_MODEL_ROUTE=tripwire-analyst

# Guardrail profile mandated (or tightened) on each chat request.
OTARI_GUARDRAIL_PROFILE=prompt-injection

TRIPWIRE_DB=tripwire.db
