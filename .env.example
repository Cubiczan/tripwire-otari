# Workspace API token from the otari.ai dashboard (starts with otk_).
# Leave empty to run in clearly labeled MOCK mode. Never commit a real token.
OTARI_API_KEY=

# Optional second workspace key for the per-user budget demo (ap-agent-west).
OTARI_API_KEY_WEST=

# Hosted US endpoint. EU accounts should use https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# auto (default): live when OTARI_API_KEY is set, otherwise mock
# mock: force the labeled mock even if a key is present
# live: require a key and call hosted Otari
OTARI_MODE=auto

# Confirm exact selectors with GET /api/v1/models. Defaults are cheap open-weight
# chat models that reported tools support in the catalog on 10 Nov 2026.
OTARI_MODEL_ANALYST=xiaomi/mimo-v2.6-flash
OTARI_MODEL_VERIFIER=z-ai/glm-5.3-flash

# Name of a Fallback routing policy created in the Otari dashboard.
# Until that policy exists, the demo retries in the client after a failed name.
OTARI_MODEL_ROUTE=tripwire-analyst

# Only set this to the user that owns the workspace key. A mismatched `user`
# field is refused with 403 and is not sent by default.
OTARI_USER=

# Guardrail profile to tighten per request, once a guardrails service is mandated.
OTARI_GUARDRAIL_PROFILE=prompt-injection

# Optional Streamable-HTTP MCP server URL reachable from Otari (name + url required).
OTARI_MCP_SERVER_URL=

# Cap completion length on live calls (keep spend low).
OTARI_MAX_TOKENS=256

TRIPWIRE_DB=tripwire.db
